# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore) - nunca comite chave real.

# Chave da API da OpenAI - usada pelo assistente (Arthur, secao 3.5).
# Opcional: sem ela, o assistente responde com um aviso e o resto funciona.
OPENAI_API_KEY=

# Token de autenticacao da API (Miguel, fase final - itens 21 e 22).
# Opcional: vazio, a API roda aberta. Preenchido, o frontend precisa do
# mesmo valor em frontend/.env (VITE_API_TOKEN).
API_TOKEN=

# Endereco(s) do frontend que podem chamar a API pelo navegador (CORS).
# Opcional: vazio, vale http://localhost:5173 e http://127.0.0.1:5173.
# Mais de um, separe por virgula.
FRONTEND_URL=
