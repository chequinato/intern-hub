# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore) - nunca comite chave real.

# Assistente de IA (opcional: sem chave, ele responde com um aviso e o
# resto do sistema funciona igual).
# IA_PROVEDOR: groq (padrao, gratuito - chave em https://console.groq.com/keys),
#              gemini (gratuito com limite - https://aistudio.google.com/apikey)
#              ou openai (pago - https://platform.openai.com/api-keys).
# IA_MODELO e opcional: vazio usa o modelo padrao de cada provedor.
IA_PROVEDOR=groq
IA_CHAVE=
IA_MODELO=

# Chave do aplicativo (Miguel, fase final - itens 21 e 22). Vai no header
# X-API-Key e identifica o FRONTEND, nao a pessoa (quem identifica a pessoa
# e o login, com e-mail e senha). Opcional: vazio, a API aceita qualquer
# cliente. Preenchido, o frontend precisa do mesmo valor em frontend/.env
# (VITE_API_TOKEN).
API_TOKEN=

# Endereco(s) do frontend que podem chamar a API pelo navegador (CORS).
# Opcional: vazio, vale http://localhost:5173 e http://127.0.0.1:5173.
# Mais de um, separe por virgula. O QR code do cracha aponta para o
# primeiro endereco da lista.
FRONTEND_URL=
