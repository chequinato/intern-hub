# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore).

# Endereco da API (uvicorn api.app_api:app --reload). Deixe assim para
# rodar tudo local.
VITE_API_URL=http://localhost:8000

# Token da API (api/seguranca.py, itens 21-22 do README). Copie o mesmo
# valor do API_TOKEN configurado no .env da raiz do projeto. Se a API
# estiver rodando sem token configurado, deixe este campo vazio tambem.
VITE_API_TOKEN=
