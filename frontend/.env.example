# Copie este arquivo para .env e preencha os valores.
# O .env NAO vai para o Git (esta no .gitignore).

# Endereco da API (uvicorn api.app_api:app --reload). Deixe assim para
# rodar tudo local.
VITE_API_URL=http://localhost:8000

# Chave do aplicativo (api/seguranca.py, itens 21-22 do README), enviada no
# header X-API-Key. Copie o mesmo valor do API_TOKEN do .env da raiz. Se a
# API estiver rodando sem chave configurada, deixe este campo vazio tambem.
# (O login de cada pessoa e outra coisa: e feito na tela de entrada.)
VITE_API_TOKEN=
